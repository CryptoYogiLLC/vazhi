<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme for Android 15+ (API 35+): edge-to-edge is enforced.
         Do NOT set android:windowOptOutEdgeToEdgeEnforcement=true.
         Flutter handles edge-to-edge rendering via its own SystemChrome APIs. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">false</item>
    </style>
</resources>
